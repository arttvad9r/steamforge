<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (cloud backup + device transfer): whitelist — ТОЛЬКО файл прогресса DataStore.
  Прогресс и состояние наград восстанавливаются единым снимком — двойных выдач не возникает.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore"/>
    </device-transfer>
</data-extraction-rules>
